# Path to the Python executable that can run predict_cli.py
# Override only if your virtualenv is in a different location.
PREDICT_PYTHON_PATH=C:\\Users\\admin\\Downloads\\datasets\\.venv\\Scripts\\python.exe

# Optional: port override for the backend server
# PORT=3000

# Optional: admin registration access code
# If set, users can register as admin only when this code is provided.
# ADMIN_REGISTRATION_CODE=your_admin_code

# SMTP (email verification + password reset)
# For Gmail, use an App Password and keep secure=false with port 587.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-app-password
# SMTP_POOL=true
# RESET_EMAIL_FROM="Gestura <your-email@example.com>"
# FRONTEND_VERIFY_URL=http://localhost:5173/verify-email
# FRONTEND_RECOVERY_VERIFY_URL=http://localhost:3000/auth/verify-recovery-email
# FRONTEND_RESET_URL=http://localhost:5173/reset-password
